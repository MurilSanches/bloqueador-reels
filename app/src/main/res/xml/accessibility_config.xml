<?xml version="1.0" encoding="utf-8"?>
<!--
  Só recebe eventos do Instagram (filtro feito pelo sistema). Quando o usuário sai do Instagram,
  o serviço percebe pela vigilância do overlay (ReelsBlockerService.vigia), não por eventos:
  consulta a cada 80 ms o id da janela ativa (flagRetrieveInteractiveWindows, só metadados) e lê o
  pacote dela quando muda e a cada 0,6 s.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true"
    android:isAccessibilityTool="false"
    android:packageNames="com.instagram.android"
    android:notificationTimeout="50"
    android:description="@string/accessibility_description" />
